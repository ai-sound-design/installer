<Application x:Class="AiSoundDesign.Installer.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="Accent" Color="#3B5BDB"/>
        <SolidColorBrush x:Key="AccentSoft" Color="#E7ECFB"/>
        <SolidColorBrush x:Key="Secondary" Color="#6B6B6B"/>
        <SolidColorBrush x:Key="CardBorder" Color="#D9D9D9"/>
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF"/>
        <Style TargetType="TextBlock" x:Key="Detail">
            <Setter Property="Foreground" Value="{StaticResource Secondary}"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,3,0,0"/>
        </Style>
        <Style TargetType="Border" x:Key="Badge">
            <Setter Property="CornerRadius" Value="9"/>
            <Setter Property="Padding" Value="7,1"/>
            <Setter Property="Margin" Value="6,0,0,0"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="14,5"/>
            <Setter Property="MinWidth" Value="84"/>
            <Setter Property="Margin" Value="8,0,0,0"/>
        </Style>
    </Application.Resources>
</Application>
